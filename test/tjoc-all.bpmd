= Output Party

M# Receive CTS
M# Protected Output Data available
.- P3.3: Retrieve Output Data
 T! ->cancel"Timeout"
 E! ->cancel"failure"
M. Output retrieved

XG <-cancel
M. @cancel

= System Operator

.# P3
.- A3.1 Distribute signed CTS
.- A3.2 Monitor CT
 ^! ->p34"Abort initiated"
 T! ->p34"Timeout"
 E! ->p34"Failure"

.- A3.3 Archive the CT metadata
.. CT finished

XG <-p34
.- P3.4 Perform emergency cleanup
!. CT cancelled

= Input Party

M# Receive CTS
T# Computation timeslot reached
.- P3.1 Prepare and upload Input Data
 T! ->cancel"timeout"
 E! ->cancel"failure"
.. Input Data submitted

XG <-cancel
M. @cancel

= Set of Computing Parties ~multiple

M# Receive CTS
.- A3.4 Prepare for computations
T# Computation timeslot reached
C# Protected Input Data from all IPs accepted
.- A3.5 Perform computation
 T! ->cancel"Timeout"
 E! ->cancel"failure"
M. Protected Output Data available

XG <-cancel
M. @cancel


MF <-so-a31 ->socp-receive
MF <-so-a31 ->ip-receive
MF CTS [signed] <-so-a31 ->op-receive
MF <-op-output-retrieved ->so-a32
MF <-op-cancel ->so-p34
MF <-ip-cancel ->so-p34
MF <-socp-cancel ->so-p34
MF <-socp-available ->output-party-available
