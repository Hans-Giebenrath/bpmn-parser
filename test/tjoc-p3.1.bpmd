// TODO Allow events without text
// TODO Branching Gateway UX is complicated with success cases - unneccessary outgoing branch. Maybe
// allow for an id-less arrow? `->` or `->"label"` That should then implicitly be the right-of case as well.
// TODO Joining Gateway UX is complicated with success cases - unneccessary additional incoming
// branch. Just allow implicit incoming branch if the lifeline is still active, as that one usually
// does not have any label.
// TODO can labels be reused? Would be nice if `no` case of gateways could be reused.

= Input Party

# P3.1 ->reboot
X <-reboot
- A3.1.1 Prepare Input Data ~user
- A3.1.2 Validate Input Data Quality Locally ~service
X Validated? ->val ->reboot no
- A3.1.3 Apply Protection to Input data ~service <-val yes
- A3.1.4 Submit Protected Input Data ~send
# Receive Message
X Upload succeeded? ->reboot no  ->upload
. Input Data submitted <-upload yes

= Set of Computing Parties

# Receive
- A3.1.5 Validate Input Data Quality ~service
X Validated OK? ->val
- A3.1.6 Store Protected Input Data <-val yes ->merge ~service

X <-val no <-merge
. Notify Input Party about data upload status

OD Signed CTS ->input-prepare-input-data
 & Signed CTS ->set-validate-input-data

OD E3.1 Input Data
  <-input-prepare-input-data
  ->input-validate-input-data-quality
  ->input-apply-protection
// TODO why does it panic with the additional one?
 & E3.2 Protected Input Data <-input-apply ->input-submit-data //->input-data-submitted
 & E3.2 Protected Input Data <-set-receive ->set-validate ->set-store
 & E3.2 Protected Input Data [validated] <-set-store

MF <-input-submit-protected-input-data ->set-receive
MF <-set-notify ->input-receive
